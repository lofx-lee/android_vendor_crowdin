    <string name="live_display_summary">படிக்குந் தன்மையை மேம்படுத்தவும், கண் சோர்வைக் குறைக்கவும், நாளின் நேரத்திற்கும் சுற்றுப்புற நிலைமைகளுக்கும் ஏற்ப உமது திரையை மேம்படுத்துக</string>
    <string name="live_display_mode">காட்சி முறை</string>
    <string name="live_display_color_temperature_title">வண்ண வெப்பநிலை</string>
