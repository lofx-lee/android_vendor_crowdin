    <string name="setting_enabled_title">விரைவுத் தட்டலைப் பயன்படுத்து</string>
    <string name="setting_action_title" product="default">மொபைலின் பின்புறம் இருமுறை தட்டி</string>
    <string name="launch_settings_activity_title">\'விரைவுத் தட்டல்\' அமைப்புகள்</string>
    <string name="setting_app_selection_help_text" product="default">உங்கள் மொபைலின் பின்புறத்தில் இருமுறை தட்டும்போது திறக்க வேண்டிய ஆப்ஸைத் தேர்ந்தெடுக்கவும். ஆப்ஸை நிறுவல் நீக்கினால் நீங்கள் வேறொரு ஆப்ஸைத் தேர்ந்தெடுக்கும் வரை \'விரைவுத் தட்டல்\' முடக்கப்பட்டிருக்கும்.</string>
    <string name="setting_app_shortcut_selection_help_text">\'விரைவுத் தட்டல்\' சைகையைப் பயன்படுத்தி இந்த ஆப்ஸைத் திறக்கும்போது என்ன நடக்க வேண்டும் என்பதைத் தேர்ந்தெடுக்கவும்.</string>
    <string name="radio_button_extra_widget_a11y_label"><xliff:g id="action">%1$s</xliff:g> அமைப்புகள்</string>
    <string name="setting_action_launch_summary_no_selection">ஆப்ஸ் எதுவும் தேர்ந்தெடுக்கப்படவில்லை</string>
    <string name="setting_action_launch_summary_not_installed">ஆப்ஸ் நிறுவப்படவில்லை</string>
